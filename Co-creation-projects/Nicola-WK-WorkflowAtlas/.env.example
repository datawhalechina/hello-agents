WORKFLOW_PROVIDER=local-demo
WORKFLOW_API_TOKEN=
WORKFLOW_EXTERNAL_LLM_ENABLED=false
WORKFLOW_EXTERNAL_DATA_AUTHORIZED=false
WORKFLOW_LLM_MODEL=
WORKFLOW_LLM_API_KEY=
