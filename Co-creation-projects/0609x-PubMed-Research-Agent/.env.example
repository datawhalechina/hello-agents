# ============================================================
# PubMed-Research-Agent Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env

# --- HelloAgents LLM 配置（毕业设计 Demo 使用） ---
# 支持任意 OpenAI 兼容接口：DeepSeek / Qwen(DashScope) / OpenAI GPT
LLM_MODEL_ID=deepseek-chat
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT=60

# --- 兼容项目原有 LLM 变量（main.ipynb 会自动映射到上面的 LLM_*） ---
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=4096

# --- PubMed（NCBI E-utilities） ---
# 可选：NCBI API Key 提高限流至 10 req/s，注册：https://account.ncbi.nlm.nih.gov/settings/
PUBMED_EMAIL=your_email@example.com
PUBMED_API_KEY=
PUBMED_VERIFY_SSL=true

# --- 完整系统（FastAPI + Vue3，可选配置） ---
APP_NAME=PubMed-Research-Agent
APP_VERSION=0.1.0
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/pubmed_agent.db

# --- Embedding / RAG ---
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v3
EMBED_API_KEY=sk-your-dashscope-key
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Qdrant 云服务（语义检索） ---
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-key
QDRANT_COLLECTION_NAME=pubmed_articles

# --- Neo4j Aura（知识图谱） ---
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- 功能开关 ---
VECTOR_STORE_ENABLED=true
NEO4J_ENABLED=true
