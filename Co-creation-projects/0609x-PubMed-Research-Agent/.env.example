# ============================================================
# PubMed-Research-Agent  Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env

# --- Application ---
APP_NAME=PubMed-Research-Agent
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- FastAPI Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=false
TRUSTED_HOSTS=*
ENABLE_API_DOCS=true

# --- Vue3 Frontend ---
FRONTEND_PORT=5173
BACKEND_API_URL=http://localhost:8000/api/v1

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/pubmed_agent.db
# For PostgreSQL production:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/pubmed_agent
# Docker Compose database settings (replace the password before deployment):
POSTGRES_DB=pubmed_agent
POSTGRES_USER=pubmed_agent
POSTGRES_PASSWORD=replace-with-a-strong-password
# Optional URL-encoded override when the password contains URL special characters:
# POSTGRES_DATABASE_URL=postgresql+asyncpg://user:encoded-pass@postgres:5432/pubmed_agent

# --- Background Jobs ---
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=5
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1740
SEARCH_JOB_STALE_AFTER_SECONDS=2100

# --- Shared LLM Cache ---
# Use "disk" only for offline development; production should use Redis.
PROMPT_CACHE_BACKEND=redis
PROMPT_CACHE_REDIS_URL=redis://localhost:6379/1
PROMPT_CACHE_TTL_HOURS=24
PROMPT_CACHE_NAMESPACE=pubmed-agent:prompt-cache
PROMPT_CACHE_LOCK_TIMEOUT=300
PROMPT_CACHE_LOCK_WAIT_TIMEOUT=30

# --- PubMed ---
# Optional: NCBI API Key for higher rate limit (10 req/s vs 3 req/s)
# Register at: https://account.ncbi.nlm.nih.gov/settings/
# Corporate proxy / SSL interception: set to false to skip PubMed certificate checks
PUBMED_VERIFY_SSL=true
PUBMED_API_KEY=
PUBMED_TOOL_NAME=PubMed-Research-Agent
PUBMED_EMAIL=your_email@example.com

# --- LLM (OpenAI Compatible Interface) ---
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
# LLM request timeout in seconds (default 240)
LLM_TIMEOUT=240

# Alternative: local vLLM / Ollama
# LLM_API_BASE=http://localhost:8000/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=meta-llama/Meta-Llama-3-70B-Instruct

# --- Embedding Model (for RAG) ---
EMBEDDING_API_BASE=${LLM_API_BASE}
EMBEDDING_API_KEY=${LLM_API_KEY}
EMBEDDING_MODEL=text-embedding-3-small

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=pubmed_articles

# --- Rate Limiting ---
PUBMED_RATE_LIMIT=3
PUBMED_RATE_LIMIT_WITH_KEY=10

# --- Neo4j Aura (Knowledge Graph, optional) ---
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- Embedding (DashScope / Alibaba Cloud) ---
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v3
EMBED_API_KEY=sk-your-dashscope-key
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Feature Switches ---
NEO4J_ENABLED=true
TAVILY_ENABLED=false
