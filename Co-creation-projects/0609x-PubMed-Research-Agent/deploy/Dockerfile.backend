# Backend image: FastAPI + uvicorn for PubMed-Research-Agent.
# Build context = repository root (see deploy/docker-compose.yml).
FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install backend dependencies first (better layer caching).
COPY deploy/requirements-backend.txt .
RUN pip install --no-cache-dir -r requirements-backend.txt

# Application code (project root is /app so `backend.app.main:app` resolves).
COPY alembic.ini .
COPY backend/ backend/
COPY data/journal_metrics.json data/journal_metrics.json

RUN addgroup --system app && adduser --system --ingroup app app \
    && mkdir -p /app/data/cache /app/data/sessions \
    && chown -R app:app /app

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health/ready')"

CMD ["sh", "-c", "alembic upgrade head && exec uvicorn backend.app.main:app --host 0.0.0.0 --port 8000"]
