# 应用配置
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
DATABASE_URL=sqlite:///./wellness.db

# LLM 配置：Ollama 本地离线（OpenAI 兼容接口）
LLM_PROVIDER=ollama
LLM_MODEL_ID=qwen2.5:7b
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.3

# 在线大模型 API 示例（替换上面 4 项即可）
# LLM_PROVIDER=openai_compatible
# LLM_MODEL_ID=deepseek-chat
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=https://api.deepseek.com/v1

# Agent 配置
AGENT_MAX_STEPS=8
TRACE_ENABLED=true
