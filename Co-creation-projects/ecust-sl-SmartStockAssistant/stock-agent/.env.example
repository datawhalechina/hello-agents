# ModelScope Qwen
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# 报告生成模型（综合分析）
QWEN_MODEL=Qwen/Qwen3.5-35B-A3B

# 情感分析模型（推荐用 MoE 模型，单次 ~2s）
QWEN_SENTIMENT_MODEL=Qwen/Qwen3-235B-A22B

# 可选数据源
TUSHARE_TOKEN=
POLYGON_API_KEY=
NEWS_API_KEY=

# 运行模式（true 时无需任何 API key）
USE_MOCK_DATA=false
