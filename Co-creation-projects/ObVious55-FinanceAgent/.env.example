# Local LLM configuration.
LLM_API_KEY=your_api_key_here
LLM_PROVIDER=deepseek
LLM_MODEL_ID=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=60
LLM_SDK_MAX_RETRIES=0
LLM_JSON_RESPONSE_FORMAT=json_schema
LLM_MAX_ATTEMPTS=4
LLM_RETRY_BASE_DELAY=2
LLM_RETRY_MAX_DELAY=8
LLM_RETRY_JITTER=0.5

# Optional local-only acceptance policy. Leave empty to use the public demo policy.
# Never commit the referenced private policy file.
# FINANCE_ACCEPTANCE_POLICY=D:\private\research_finance_acceptance.json

# Compatible fallback names are also supported:
# OPENAI_API_KEY=your_api_key_here
# LLM_MODEL=deepseek-v4-flash

# Provider strategy options:
# - deepseek: do not request JSON Schema; use json_object then fall back to prompt-only JSON.
# - openai: request native JSON Schema, then fall back to json_object/prompt-only JSON if needed.
# - plain: never pass response_format.
# LLM_PROVIDER=deepseek

# JSON response format options:
# - json_schema: request OpenAI-compatible JSON Schema output for JSON agents, then fall back to json_object/none if unsupported.
# - json_object: request generic JSON object mode.
# - none: do not pass response_format.
# LLM_JSON_RESPONSE_FORMAT=json_schema

# Optional MySQL state snapshot persistence.
# Matches the root docker-compose.yml defaults.
# REPORT_STATE_MYSQL_ENABLED=1
# REPORT_STATE_MYSQL_HOST=127.0.0.1
# REPORT_STATE_MYSQL_PORT=3307
# REPORT_STATE_MYSQL_DATABASE=finance_agent
# REPORT_STATE_MYSQL_USER=finance_user
# REPORT_STATE_MYSQL_PASSWORD=finance_password
# REPORT_STATE_MYSQL_STRICT=1

# LangGraph checkpoint persistence.
# mysql: persist interrupt/resume checkpoints in MySQL via PyMySQLSaver.
# memory: in-process only, useful for unit tests and local debugging.
# none: disable checkpointing.
# If unset, interactive runs use mysql when REPORT_STATE_MYSQL_ENABLED=1, otherwise memory.
# REPORT_CHECKPOINT_BACKEND=mysql

# Read-only material folder scan for AcceptanceReviewAgent.
# The MCP tool can only list file names and metadata under this root.
# MATERIAL_ROOT=D:\Code\finance-agent\project_materials
# MATERIAL_SCAN_MAX_FILES=1000

# Local development fallback only. Production should keep snapshots in MySQL.
# REPORT_STATE_FILE_SNAPSHOT_FALLBACK=0

# Full state diff files are disabled by default and should only be enabled for debugging.
# REPORT_WRITE_STATE_DIFFS=0
