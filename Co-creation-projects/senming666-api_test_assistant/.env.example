# ============================================================
# 智能API测试助手 - 环境变量配置模板
#
# 使用方法：
#   1. 复制本文件并重命名为 .env
#   2. 把下面的占位符替换成你的真实值
#   3. .env 文件不要提交到 GitHub（里面是密钥）
# ============================================================

# ========== LLM 配置（必需）==========

# 模型名称（你的中转站支持哪个就填哪个）
LLM_MODEL_ID=gpt-5.6-luna

# API 密钥
LLM_API_KEY=your_api_key_here

# API 地址（中转站或官方端点）
LLM_BASE_URL=https://app.pinaic.com/v1

# 请求超时时间（秒）。生成测试用例耗时较长，建议设大一点
LLM_TIMEOUT=120
