# Required model configuration
ANTHROPIC_API_KEY=your-api-key
MODEL_ID=your-model-id
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# request: ask before Bash and confirm-required MCP tools
# full: auto-approve ordinary commands, while permanent safety rules still apply
PERMISSION_MODE=request

# Prompt caching and context budgeting
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_TTL=5m
CONTEXT_ACTIVE_THRESHOLD=0.70
CONTEXT_COMPACT_THRESHOLD=0.85
CONTEXT_SUMMARY_THRESHOLD=0.95
KEEP_RECENT_TOOL_RESULTS=3
# Save full prompts/messages in web Trace only when explicitly debugging.
TRACE_FULL_PAYLOAD=false
# Optional: input price used only for an estimated USD savings display.
# INPUT_COST_PER_MILLION=3.0
# CACHE_READ_COST_MULTIPLIER=0.1
