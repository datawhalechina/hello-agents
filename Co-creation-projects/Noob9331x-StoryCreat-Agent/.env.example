# ============================================================================
# 智能故事生成器 · 环境变量示例
# 复制为 .env 后填写自己的模型信息：cp .env.example .env
# 配置优先级：进程环境变量 > .env > 代码默认值
# ============================================================================

# ---- LLM（OpenAI 兼容接口，必填）----
LLM_MODEL_ID=glm-4-flash
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_TIMEOUT=180

# ---- 生成与审稿参数（可选）----
# 写作温度越高越发散；审稿温度建议保持 0 以保证评分稳定
LLM_TEMPERATURE_WRITER=0.8
LLM_TEMPERATURE_REVIEWER=0.0
# 通过分数线：加权总分与相关性均需达标
APPROVE_SCORE=80
MIN_RELEVANCE_SCORE=80
MAX_ROUNDS_DEFAULT=2

# ---- 服务（可选）----
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 运行目录保留数量，超出后自动清理最旧的运行
CLEANUP_KEEP_RUNS=50
LOG_LEVEL=INFO
TRACE_ENABLED=true

# ---- 路径（可选，相对路径按项目根目录解析）----
# OUTPUT_DIR=outputs
# FRONTEND_DIR=frontend
# DATA_DIR=data
