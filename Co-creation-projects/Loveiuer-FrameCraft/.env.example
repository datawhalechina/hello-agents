# Optional: demo mode needs no credentials. Never commit the real .env.
FIGMA_ACCESS_TOKEN=
# Figma token needs file_content:read and access to the selected file.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_JSON_MODE=true
# Set false only if the provider does not support response_format=json_object.
# For a slow reasoning model, LLM_TIMEOUT may be raised to 120 seconds.
# OPENAI_API_KEY / OPENAI_BASE_URL / MODEL_NAME are also supported.
