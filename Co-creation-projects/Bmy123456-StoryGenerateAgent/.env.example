# AI模型配置
OPENAI_API_KEY=your_api_key_here
BASE_URL=you_base_url_here
MODEL_NAME=your_model_name_here
TEMPERATURE=0.7
MAX_TOKENS=1000

# 缓存配置
CACHE_ENABLED=True
CACHE_EXPIRE_SECONDS=3600

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 其他配置
MAX_GENERATION_ATTEMPTS=3
DEFAULT_GENERATION_TYPE=novel

# 应用配置
DEBUG=True
HOST=0.0.0.0
PORT=8000