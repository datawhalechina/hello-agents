# TMDB（二选一即可；Access Token 优先）
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# OpenAI 兼容 LLM（HelloAgents）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_ID=

# 服务器
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# HelloAgents Trace（true 时写入 TRACE_DIR；日常建议 false）
TRACE_ENABLED=false
TRACE_DIR=memory/traces
