# Copy to .env in the project directory, then fill in your model and credentials.
# Existing process environment variables take precedence over .env.
# custom means an OpenAI-compatible API; change the URL for your provider.
LLM_PROVIDER=custom
LLM_MODEL_ID=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Optional settings
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
