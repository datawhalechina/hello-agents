{
  "name": "papergraph-frontend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "vite build",
    "preview": "vite preview",
    "openapi:export": "cd ../backend && python -c \"import json,sys; from pathlib import Path; sys.path.insert(0,str(Path('.').resolve())); from app.api.main import app; Path('../frontend/openapi.json').write_text(json.dumps(app.openapi(), ensure_ascii=False, indent=2)+chr(10), encoding='utf-8')\"",
    "openapi:export:live": "curl -sS -f http://127.0.0.1:8000/openapi.json -o ./openapi.json",
    "openapi:types": "openapi-typescript ./openapi.json -o ./src/types/openapi.ts",
    "openapi:gen": "npm run openapi:export && npm run openapi:types",
    "openapi:gen:live": "npm run openapi:export:live && npm run openapi:types",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run && node --test tests/pdf-assets.test.mjs",
    "pdf:assets": "node scripts/copy-pdf-assets.mjs",
    "predev": "npm run pdf:assets",
    "prebuild": "npm run pdf:assets"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.0.7",
    "axios": "^1.6.2",
    "d3": "^7.9.0",
    "katex": "^0.16.11",
    "pdfjs-dist": "^4.0.379",
    "vue": "^3.3.8",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@vitejs/plugin-vue": "^5.0.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.2.12",
    "@types/katex": "^0.16.7",
    "@types/d3": "^7.4.3",
    "vitest": "^1.6.1",
    "jsdom": "^24.1.3"
  }
}
