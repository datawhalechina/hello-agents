# ==========================================
# LLM 配置（DeepSeek，OpenAI 兼容接口）
# 复制本文件为 .env 并填入你的真实密钥
# ==========================================

# 模型名称（deepseek-flash / deepseek-chat）
LLM_MODEL_ID=deepseek-flash

# API Key（在 https://platform.deepseek.com 获取）
LLM_API_KEY=your_api_key_here

# API 基础地址
LLM_BASE_URL=https://api.deepseek.com

# 请求超时（秒）
LLM_TIMEOUT=60
