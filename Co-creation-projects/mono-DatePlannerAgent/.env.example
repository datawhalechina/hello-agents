# 高德开放平台 Web 服务 Key（必填）
# 申请地址：https://console.amap.com/dev/key/app
AMAP_KEY=your_amap_web_key_here

# ===== HelloAgents 框架（可选，demo_agent.py 使用）=====
# LLM 模型 ID（OpenAI 兼容格式，如 deepseek-chat / gpt-4o-mini / qwen-plus）
LLM_MODEL_ID=deepseek-chat
# LLM API Key（配好后才可运行 LLM 自动规划；只想演示工具链可先跑 python demo_agent.py --dry-run）
LLM_API_KEY=your_llm_api_key_here
# LLM 服务地址（可选，默认 OpenAI 官方；DeepSeek 填 https://api.deepseek.com/v1）
LLM_BASE_URL=https://api.deepseek.com/v1
