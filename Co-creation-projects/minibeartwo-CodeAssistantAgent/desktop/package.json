{
  "name": "code-assistant-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local CodeAssistantAgent desktop client",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
