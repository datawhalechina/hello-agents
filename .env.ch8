# Hello-Agents chapter8 local runtime config
# 使用 TF-IDF 作为第一版 embedding，避免一开始拉入 torch 重依赖
EMBED_MODEL_TYPE=tfidf
# 如果你以后有 DashScope key，可以切换成：dashscope
# EMBED_MODEL_TYPE=dashscope
# EMBED_API_KEY=
# EMBED_BASE_URL=

# 让 hello-agents 的 RAG 跑在本地目录，而不是 localhost:6333
QDRANT_LOCAL_PATH=/home/ubuntu/work/hello-agents/hello_ch8_data/qdrant_local

# 若你要真正使用 RAGTool.ask 的 LLM 生成，需要填这三个
# LLM_MODEL_ID=
# LLM_API_KEY=
# LLM_BASE_URL=
